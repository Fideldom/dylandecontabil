@{
    var empresa = (string)(ViewBag.Empresa ?? "DYLANDE — Prestação de Serviços e Comércio");
    var module = (string)(ViewBag.Module ?? "Visão geral");
}
<!DOCTYPE html>
<html lang="pt-AO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@module · DYLANDE Contabil</title>
    <meta name="description" content="DYLANDE Contabil — gestão contabilística empresarial." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body class="app-page">
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <div class="brand-wrap">
            <a class="brand" asp-controller="Home" asp-action="Dashboard" asp-route-empresa="@empresa">
                <span class="brand-mark">D</span>
                <span><strong>dylande</strong><small>contabil</small></span>
            </a>
            <button class="sidebar-close" id="sidebarClose" type="button" aria-label="Fechar menu"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="workspace">
            <span>EMPRESA ACTIVA</span>
            <strong>@empresa</strong>
            <small>Exercício contabilístico · 2026</small>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">ESPAÇO DE TRABALHO</div>
            <a class="nav-link @(module == "Visão geral" ? "active" : "")" asp-controller="Home" asp-action="Dashboard" asp-route-empresa="@empresa">
                <i class="nav-icon bi bi-grid-1x2"></i><span>Visão geral</span>
            </a>

            <div class="nav-section">CONTABILIDADE</div>
            <a class="nav-link @(module == "Plano de Contas" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Plano de Contas" asp-route-empresa="@empresa"><i class="nav-icon bi bi-list-columns"></i><span>Plano de Contas</span></a>
            <a class="nav-link @(module == "Lançamentos" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Lançamentos" asp-route-empresa="@empresa"><i class="nav-icon bi bi-journal-plus"></i><span>Lançamentos</span></a>
            <a class="nav-link @(module == "Diário Geral" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Diário Geral" asp-route-empresa="@empresa"><i class="nav-icon bi bi-journal-text"></i><span>Diário Geral</span></a>
            <a class="nav-link @(module == "Razão Geral" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Razão Geral" asp-route-empresa="@empresa"><i class="nav-icon bi bi-book"></i><span>Razão Geral</span></a>
            <a class="nav-link @(module == "Balancetes" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Balancetes" asp-route-empresa="@empresa"><i class="nav-icon bi bi-table"></i><span>Balancetes</span></a>
            <a class="nav-link @(module == "Regularizações" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Regularizações" asp-route-empresa="@empresa"><i class="nav-icon bi bi-arrow-repeat"></i><span>Regularizações</span></a>
            <a class="nav-link @(module == "Apuramento" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Apuramento" asp-route-empresa="@empresa">
                <i class="nav-icon bi bi-calculator"></i><span>Apuramento</span>
            </a>

            <div class="nav-section">RELATÓRIOS FINANCEIROS</div>
            <a class="nav-link @(module == "Demonstrações Financeiras" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Demonstrações Financeiras" asp-route-empresa="@empresa">
                <i class="nav-icon bi bi-bar-chart-line"></i><span>Demonstrações financeiras</span>
            </a>

            <div class="nav-section">ADMINISTRAÇÃO</div>
            <a class="nav-link @(module == "Definições" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="Definições" asp-route-empresa="@empresa"><i class="nav-icon bi bi-gear"></i><span>Definições</span></a>
        </nav>

        <div class="sidebar-footer">
            <div class="security-line"><span class="security-dot"></span><span>Sessão segura</span></div>
            <a class="profile-mini" href="#" id="profileButton">
                <span class="avatar">FM</span><span><strong>Contabilista</strong><small>Perfil profissional</small></span><span class="profile-more"><i class="bi bi-three-dots"></i></span>
            </a>
            <a class="logout-link" asp-controller="Home" asp-action="Login"><i class="bi bi-box-arrow-right"></i> Terminar sessão</a>
        </div>
    </aside>

    <div class="mobile-overlay" id="mobileOverlay"></div>
    <main class="main">
        <header class="topbar">
            <button class="menu-button" id="menuButton" type="button" aria-label="Abrir menu"><i class="bi bi-list"></i></button>
            <div class="topbar-context">
                <span>Contabilidade</span><b>/</b><strong>@module</strong>
            </div>
            <div class="topbar-actions">
                <button class="top-action" type="button" id="notificationsButton" aria-label="Notificações"><i class="bi bi-bell"></i><i></i></button>
                <span class="top-divider"></span>
                <div class="top-company">
                    <span class="company-avatar">DY</span>
                    <span><small>EMPRESA</small><strong>@empresa</strong></span>
                </div>
            </div>
        </header>
        <div class="content">
            @RenderBody()
        </div>
    </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="~/js/app.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
