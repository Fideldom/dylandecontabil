@{
    var empresa=(string)(ViewBag.Empresa ?? "");
}
<div class="page-head">
 <div>
  <span class="eyebrow">
   CONTABILIDADE · ESTRUTURA
  </span>
  <h1>
   Plano de Contas
  </h1>
  <p>
   Estrutura contabilística, classificação e natureza das contas.
  </p>
 </div>
 <div class="page-actions">
  <button class="btn btn-secondary" onclick="exportTable('accountsTable','plano-de-contas.xls')">
   Exportar Excel
  </button>
  <button class="btn btn-primary" onclick="openModal('accountModal')">
   <i class="bi bi-plus-lg"></i> Nova conta
  </button>
 </div>
</div>
<div class="grid grid-4 section-bottom">
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-list"></i>
  </span>
  <div>
   <small>
    Total de contas
   </small>
   <strong id="accountTotal">
    15
   </strong>
   <span>
    Plano actual
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-diagram-3"></i>
  </span>
  <div>
   <small>
    Sintéticas
   </small>
   <strong>
    7
   </strong>
   <span>
    Contas de agrupamento
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-diagram-2"></i>
  </span>
  <div>
   <small>
    Analíticas
   </small>
   <strong>
    8
   </strong>
   <span>
    Contas de movimento
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-check-lg"></i>
  </span>
  <div>
   <small>
    Activas
   </small>
   <strong>
    14
   </strong>
   <span>
    Disponíveis para lançamentos
   </span>
  </div>
 </article>
</div>
<section class="panel">
 <div class="panel-head">
  <div>
   <h2>
    Estrutura de contas
