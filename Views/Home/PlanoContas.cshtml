  </span>
 </div>
 <div class="toolbar">
  <label class="search-box">
   <span>
    <i class="bi bi-search"></i>
   </span>
   <input id="accountSearch" oninput="filterTable('accountSearch','accountsTable')" placeholder="Pesquisar código ou nome..."/>
  </label>
  <label class="field">
   <span>
    Classe
   </span>
   <select>
    <option>
