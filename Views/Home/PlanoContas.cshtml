<div class="modal-backdrop" id="accountModal">
 <div class="modal">
  <div class="modal-head">
   <div>
    <h2>
     Nova conta contabilística
    </h2>
    <p>
     Defina a estrutura e a natureza da conta.
    </p>
   </div>
   <button class="modal-close" data-close="accountModal">
    ×
   </button>
  </div>
  <form class="js-demo-submit">
   <div class="modal-body">
    <div class="form-grid">
     <label class="field">
      <span>
       Código da conta *
      </span>
      <input placeholder="Ex.: 3.1.01" required=""/>
     </label>
     <label class="field">
      <span>
       Classe contabilística *
      </span>
      <select>
       <option>
        Patrimonial
       </option>
       <option>
        Resultados
       </option>
       <option>
        Terceiros
       </option>
       <option>
        Orçamental
       </option>
      </select>
     </label>
     <label class="field field-full">
      <span>
       Nome da conta *
      </span>
      <input placeholder="Designação oficial da conta" required=""/>
     </label>
     <label class="field">
      <span>
       Conta superior
      </span>
      <select>
       <option>
        Sem conta superior
       </option>
       <option>
        3 — Terceiros
       </option>
       <option>
        3.1 — Clientes
       </option>
       <option>
        4 — Meios monetários
       </option>
      </select>
     </label>
     <label class="field">
      <span>
       Tipo de conta
      </span>
      <select>
       <option>
        Analítica
       </option>
       <option>
        Sintética
       </option>
      </select>
     </label>
     <label class="field">
      <span>
       Natureza
      </span>
      <select>
       <option>
        Débito
       </option>
       <option>
        Crédito
       </option>
      </select>
     </label>
     <label class="field">
      <span>
       Estado
      </span>
      <select>
       <option>
        Activa
       </option>
       <option>
        Inactiva
       </option>
      </select>
     </label>
    </div>
   </div>
   <div class="modal-foot">
    <button class="btn btn-secondary" data-close="accountModal" type="button">
     Cancelar
    </button>
    <button class="btn btn-primary" type="submit">
     Guardar conta
    </button>
   </div>
  </form>
 </div>
</div>
