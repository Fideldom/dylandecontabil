<div class="page-head">
 <div>
  <span class="eyebrow">
   EXERCÍCIO · FECHO CONTABILÍSTICO
  </span>
  <h1>
   Encerramento
  </h1>
  <p>
   Conferência, apuramento e encerramento do exercício contabilístico.
  </p>
 </div>
 <div class="page-actions">
  <button class="btn btn-secondary" onclick="printReport('Checklist de encerramento')">
   Imprimir checklist
  </button>
  <button class="btn btn-primary" onclick="showToast('O encerramento definitivo requer confirmação e permissões de administrador.')">
   Iniciar encerramento
  </button>
 </div>
</div>
<div class="notice">
 <span>
  !
 </span>
 <div>
  <b>
   Operação crítica.
  </b>
  O encerramento definitivo deve ser executado apenas após a conferência integral das contas, apuramento de resultados e aprovação do responsável.
 </div>
</div>
<div class="grid grid-3 section-bottom">
 <article class="card stat-card">
  <span class="stat-icon">
   □
  </span>
  <div>
   <small>
    Exercício
   </small>
   <strong>
    2026
   </strong>
   <span>
    Em aberto
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   ✓
  </span>
  <div>
   <small>
    Verificações concluídas
   </small>
   <strong>
    7/9
   </strong>
   <span>
    2 pendentes
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   !
  </span>
  <div>
   <small>
    Estado
   </small>
   <strong class="stat-value-small">
    Preparação
   </strong>
   <span>
    Encerramento não definitivo
   </span>
  </div>
 </article>
</div>
<section class="panel">
 <div class="panel-head">
  <div>
   <h2>
    Checklist de encerramento
   </h2>
   <p>
    Etapas obrigatórias antes do fecho definitivo.
   </p>
  </div>
 </div>
 <div class="panel-body-checklist">
  <div class="check-row">
   <span class="check done">
    ✓
   </span>
   <div>
    <strong>
     Conferência de contas
    </strong>
    <small>
     Contas patrimoniais e de resultados conferidas.
    </small>
   </div>
   <span class="badge badge-success">
    Concluído
   </span>
  </div>
  <div class="check-row">
   <span class="check done">
    ✓
   </span>
   <div>
    <strong>
     Conciliações bancárias
    </strong>
    <small>
     Conciliações do período sem diferenças pendentes.
    </small>
   </div>
   <span class="badge badge-success">
    Concluído
   </span>
  </div>
  <div class="check-row">
   <span class="check done">
    ✓
   </span>
   <div>
    <strong>
     Regularizações
    </strong>
    <small>
     Operações de ajustamento aprovadas.
    </small>
   </div>
   <span class="badge badge-success">
    Concluído
   </span>
  </div>
  <div class="check-row">
   <span class="check done">
    ✓
   </span>
   <div>
    <strong>
     Apuramento de resultados
    </strong>
    <small>
     Resultado do exercício calculado e conferido.
    </small>
   </div>
   <span class="badge badge-success">
    Concluído
   </span>
  </div>
  <div class="check-row">
   <span class="check done">
    ✓
   </span>
   <div>
    <strong>
     Transferência de saldos
    </strong>
    <small>
     Saldos preparados para a abertura do exercício seguinte.
    </small>
   </div>
   <span class="badge badge-success">
    Concluído
   </span>
  </div>
  <div class="check-row">
   <span class="check pending">
    !
   </span>
   <div>
    <strong>
     Validação do responsável
    </strong>
    <small>
     Aguardando aprovação formal do responsável contabilístico.
    </small>
   </div>
   <span class="badge badge-warning">
    Pendente
   </span>
  </div>
  <div class="check-row">
   <span class="check pending">
    !
   </span>
   <div>
    <strong>
     Encerramento definitivo
    </strong>
    <small>
     Bloqueia movimentos no exercício após confirmação.
    </small>
   </div>
   <span class="badge badge-warning">
    Bloqueado
   </span>
  </div>
 </div>
</section>
<div class="grid grid-2 section-gap">
 <section class="panel">
  <div class="panel-head">
   <div>
    <h2>
     Apuramento de resultados
    </h2>
    <p>
     Resumo antes da transferência.
    </p>
   </div>
  </div>
  <div class="kpi-stack">
   <div class="kpi-item kpi-item-compact">
    <small>
     Rendimentos
    </small>
    <strong>
     42.850.000,00 AOA
    </strong>
   </div>
   <div class="kpi-item kpi-item-compact">
    <small>
     Gastos
    </small>
    <strong>
     36.420.000,00 AOA
    </strong>
   </div>
   <div class="kpi-item kpi-item-compact kpi-item-bordered">
    <small>
     Resultado antes do imposto
    </small>
    <strong>
     6.430.000,00 AOA
    </strong>
   </div>
  </div>
 </section>
 <section class="panel">
  <div class="panel-head">
   <div>
    <h2>
     Período de encerramento
    </h2>
    <p>
     Definição do intervalo a fechar.
    </p>
   </div>
  </div>
  <div class="panel-padding">
   <div class="form-grid">
    <label class="field">
     <span>
      Exercício contabilístico
     </span>
     <select>
      <option>
       2026
      </option>
     </select>
    </label>
    <label class="field">
     <span>
      Período final
     </span>
     <input type="date" value="2026-12-31"/>
    </label>
   </div>
  </div>
 </section>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/encerramento.css" />
}
