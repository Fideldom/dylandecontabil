<div class="modal-backdrop" id="entryModal">
 <div class="modal">
  <div class="modal-head">
   <div>
    <h2>
     Novo lançamento
    </h2>
    <p>
     Registe a operação e as respectivas linhas contabilísticas.
    </p>
   </div>
   <button class="modal-close" data-close="entryModal">
    ×
   </button>
  </div>
  <form class="js-demo-submit">
   <div class="modal-body">
    <div class="form-grid">
     <label class="field">
      <span>
       N.º do lançamento
      </span>
      <input readonly="" value="000285"/>
     </label>
     <label class="field">
      <span>
       Data *
      </span>
      <input type="date" value="2026-11-05"/>
     </label>
     <label class="field">
      <span>
       Diário *
      </span>
      <select>
       <option>
        Operações diversas
       </option>
       <option>
        Compras
       </option>
       <option>
        Vendas
       </option>
       <option>
        Bancos
       </option>
      </select>
     </label>
     <label class="field">
      <span>
       Documento de origem
      </span>
      <input placeholder="Factura, recibo, transferência..."/>
     </label>
     <label class="field field-full">
      <span>
       Descrição / histórico *
      </span>
      <textarea placeholder="Descreva a operação contabilística" required="" rows="3"></textarea>
     </label>
    </div>
    <div class="form-block-gap">
     <h3 class="form-section-title">
      Linhas contabilísticas
     </h3>
     <table class="data-table">
      <thead>
       <tr>
        <th>
         CONTA
        </th>
        <th>
         DESIGNAÇÃO
        </th>
        <th>
         DÉBITO
        </th>
        <th>
         CRÉDITO
        </th>
       </tr>
      </thead>
      <tbody>
       <tr>
        <td>
         4.1.02
        </td>
        <td>
         Depósitos à ordem
        </td>
        <td>
         <input class="field input input-amount" value="0,00"/>
        </td>
        <td>
         <input class="input-amount" value="425.000,00"/>
        </td>
       </tr>
       <tr>
        <td>
         3.2.01
        </td>
        <td>
         Fornecedores nacionais
        </td>
        <td>
         <input class="input-amount" value="425.000,00"/>
        </td>
        <td>
         <input class="input-amount" value="0,00"/>
        </td>
       </tr>
      </tbody>
     </table>
    </div>
    <div class="form-grid form-grid-gap">
     <label class="field">
      <span>
       Anexos
      </span>
      <input multiple="" type="file"/>
     </label>
     <label class="field">
      <span>
       Estado inicial
      </span>
      <select>
       <option>
        Pendente
       </option>
       <option>
        Rascunho
       </option>
      </select>
     </label>
    </div>
   </div>
   <div class="modal-foot">
    <button class="btn btn-secondary" data-close="entryModal" type="button">
     Guardar rascunho
    </button>
    <button class="btn btn-primary" type="submit">
     Submeter para aprovação
    </button>
   </div>
  </form>
 </div>
</div>
