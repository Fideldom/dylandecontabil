@{
    var empresa=(string)(ViewBag.Empresa ?? "");
}
<div class="page-head">
 <div>
  <span class="eyebrow">
   CONTABILIDADE · MOVIMENTOS
  </span>
  <h1>
   Lançamentos
  </h1>
  <p>
   Registo, conferência e aprovação dos movimentos contabilísticos.
  </p>
 </div>
 <div class="page-actions">
  <button class="btn btn-secondary" onclick="showToast('Filtro avançado disponível na versão ligada ao backend.')">
   Filtros
  </button>
  <button class="btn btn-primary" onclick="openModal('entryModal')">
   <i class="bi bi-plus-lg"></i> Novo lançamento
  </button>
 </div>
</div>
<div class="notice">
 <span>
  i
 </span>
 <div>
  <b>
   Regra de conferência:
  </b>
  um lançamento só pode ser aprovado quando o total a débito for exactamente igual ao total a crédito.
 </div>
</div>
<div class="grid grid-4 section-bottom">
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-plus-lg"></i>
  </span>
  <div>
   <small>
    Este mês
   </small>
   <strong>
    284
   </strong>
   <span>
    Lançamentos
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   ◷
  </span>
  <div>
   <small>
    Pendentes
   </small>
   <strong>
    17
   </strong>
   <span>
    Aguardam aprovação
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   <i class="bi bi-check-lg"></i>
  </span>
  <div>
   <small>
    Aprovados
   </small>
   <strong>
    251
   </strong>
   <span>
    Prontos para contabilizar
   </span>
  </div>
 </article>
 <article class="card stat-card">
  <span class="stat-icon">
   !
  </span>
  <div>
   <small>
    Com anexos
   </small>
   <strong>
    96
   </strong>
   <span>
    Documentos de suporte
   </span>
  </div>
 </article>
</div>
<section class="panel">
 <div class="panel-head">
  <div>
